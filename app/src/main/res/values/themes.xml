<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the entire UI, so the platform theme only needs to remove the
      action bar and set a launch background that matches. Kept on the framework
      Material theme to avoid pulling in the Material Components view library.
    -->
    <style name="Theme.Sentinel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
